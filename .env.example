CR_BIND_IP=127.0.0.1
CR_BIND_PORT=5000

# OverlayVPN (github.com/huzaimzaoraiz/vpn) integration
# There is no admin token — auth uses a standard VPN user account (email + password).
# CyberRange will log in automatically via POST /api/v1/auth/login and cache the JWT.
#
# Step 1: Register a dedicated service account (all routes are under /api/v1/):
#   curl -X POST http://172.17.0.1:8000/api/v1/auth/register \
#     -H "Content-Type: application/json" \
#     -d '{"email":"cyberrange@internal","password":"StrongPass123!"}'
#   Then verify the OTP sent to that email (or check VPN server logs).
#   curl -X POST http://172.17.0.1:8000/api/v1/auth/verify-otp \
#     -H "Content-Type: application/json" \
#     -d '{"email":"cyberrange@internal","otp":"123456"}'
#
# Step 2: Log in and find your network ID:
#   TOKEN=$(curl -s -X POST http://172.17.0.1:8000/api/v1/auth/login \
#     -H "Content-Type: application/json" \
#     -d '{"username":"cyberrange@internal","password":"StrongPass123!"}' | jq -r .access_token)
#   curl http://172.17.0.1:8000/api/v1/networks \
#     -H "Authorization: Bearer $TOKEN"
#   → copy the "id" field of your network into VPN_V2_NETWORK_ID
VPN_V2_URL=http://172.17.0.1:8000
VPN_V2_SERVICE_EMAIL=cyberrange@internal.local
VPN_V2_SERVICE_PASS=replace-with-your-vpn-service-account-password
VPN_V2_NETWORK_ID=replace-with-network-uuid

CR_SECRET_KEY=replace-with-a-long-random-secret
CR_FLAG_SECRET=replace-with-a-long-random-flag-secret

# Database configuration (Local Docker container or MongoDB Atlas)
# For MongoDB Atlas, use:
# CR_MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cyberrange?retryWrites=true&w=majority
CR_MONGO_URI=mongodb://mongodb:27017
CR_MONGO_DB=cyberrange

# Challenge Container & Lab Network Subnet
CR_LAB_SUBNET=172.30.0.0/16
VITE_LAB_SUBNET=172.30.0.0/16
CR_CONTAINER_MEMORY_LIMIT=128m
CR_TOKEN_EXPIRY_SECONDS=86400
CR_LAB_MAX_AGE_SECONDS=7200
CR_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
CR_LOGIN_RATE_LIMIT_MAX_FAILURES=10
CR_LOGIN_RATE_LIMIT_BASE_DELAY_SECONDS=2
CR_LOGIN_RATE_LIMIT_MAX_DELAY_SECONDS=60

# Registration Email Configuration (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email@example.com
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM=noreply@overlayvpn.me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
